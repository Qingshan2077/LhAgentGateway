if (prev.getResponseCode() != &apos;200&apos;) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Mixed cache expected HTTP 200, actual &apos; + prev.getResponseCode()); return }
boolean hit = prev.getResponseHeaders().toUpperCase().contains(&apos;X-CACHE: HIT&apos;)
if (vars.get(&apos;EXPECTED_CACHE_RESULT&apos;) == &apos;HIT&apos; &amp;&amp; !hit) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Expected cache HIT but request missed&apos;) }
if (vars.get(&apos;EXPECTED_CACHE_RESULT&apos;) == &apos;MISS&apos; &amp;&amp; hit) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Expected unique cache MISS but request hit&apos;) }
              </stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
