            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="网关：拒绝未知供应商" enabled="true">
              <stringProp name="HTTPSampler.domain">${GW_HOST}</stringProp>
              <stringProp name="HTTPSampler.port">${GW_PORT}</stringProp>
              <stringProp name="HTTPSampler.protocol">http</stringProp>
              <stringProp name="HTTPSampler.path">/v1/chat/completions</stringProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
