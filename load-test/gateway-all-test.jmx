long index = counter.getAndIncrement() + 1
long max = props.get(&apos;l2_key_count&apos;,&apos;25000&apos;) as long
if (index &gt; max) { ctx.getThread().stop(); return }
def json = &apos;{&quot;model&quot;:&quot;mock-model&quot;,&quot;messages&quot;:[{&quot;role&quot;:&quot;user&quot;,&quot;content&quot;:&quot;pressure-l2-&apos; + vars.get(&apos;CACHE_NAMESPACE&apos;) + &apos;-&apos; + index + &apos;&quot;}],&quot;temperature&quot;:0,&quot;stream&quot;:false}&apos;
