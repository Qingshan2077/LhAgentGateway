            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="按 80% L1、15% L2、5% 未命中选择请求" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">
int bucket = java.util.concurrent.ThreadLocalRandom.current().nextInt(100)
def namespace = vars.get(&apos;CACHE_NAMESPACE&apos;)
def content
def expected
if (bucket &lt; 80) {
  content = &apos;pressure-mixed-l1-&apos; + namespace
  expected = &apos;HIT&apos;
  sampler.setName(&apos;混合多级缓存请求 L1 80%&apos;)
} else if (bucket &lt; 95) {
  def counter = props.get(&apos;lh.mixed.l2.counter&apos;)
  long index = counter.getAndIncrement() + 1
  long max = props.get(&apos;mixed_l2_key_count&apos;,&apos;10000&apos;) as long
  if (index &gt; max) { ctx.getThread().stop(); return }
  content = &apos;pressure-mixed-l2-&apos; + namespace + &apos;-&apos; + index
  expected = &apos;HIT&apos;
  sampler.setName(&apos;混合多级缓存请求 L2 15%&apos;)
} else {
  def counter = props.get(&apos;lh.mixed.miss.counter&apos;)
  long index = counter.getAndIncrement() + 1
  content = &apos;pressure-mixed-miss-&apos; + namespace + &apos;-&apos; + index
  expected = &apos;MISS&apos;
  sampler.setName(&apos;混合多级缓存请求 MISS 5%&apos;)
}
vars.put(&apos;EXPECTED_CACHE_RESULT&apos;, expected)
def json = &apos;{&quot;model&quot;:&quot;mock-model&quot;,&quot;messages&quot;:[{&quot;role&quot;:&quot;user&quot;,&quot;content&quot;:&quot;&apos; + content + &apos;&quot;}],&quot;temperature&quot;:0,&quot;stream&quot;:false}&apos;
sampler.getArguments().getArgument(0).setValue(json)
              </stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
