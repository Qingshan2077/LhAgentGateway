          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="功能契约断言" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">
import groovy.json.JsonSlurper

def label = prev.getSampleLabel()
def expectedCodes = [
  &apos;网关：健康检查&apos;:[&apos;200&apos;], &apos;网关：信息查询&apos;:[&apos;200&apos;], &apos;网关：Prometheus 指标&apos;:[&apos;200&apos;],
  &apos;网关：聊天请求缺少 API 密钥&apos;:[&apos;401&apos;],
  &apos;管理端：创建供应商（PUT）&apos;:[&apos;200&apos;], &apos;管理端：查询供应商（GET）&apos;:[&apos;200&apos;],
  &apos;管理端：查询供应商列表（GET）&apos;:[&apos;200&apos;], &apos;管理端：更新供应商（PUT）&apos;:[&apos;200&apos;],
  &apos;管理端：查询 PUT 更新后的供应商&apos;:[&apos;200&apos;], &apos;管理端：更新供应商权重（PATCH）&apos;:[&apos;200&apos;],
  &apos;管理端：查询权重更新后的供应商&apos;:[&apos;200&apos;],
  &apos;网关：聊天补全&apos;:[&apos;200&apos;],
  &apos;网关：聊天请求包含无效 JSON&apos;:[props.get(&apos;invalid_json_expected_code&apos;,&apos;400&apos;)],
  &apos;网关：获取模型列表（GET）&apos;:[props.get(&apos;models_expected_code&apos;,&apos;200&apos;)],
  &apos;网关：访问未知 v1 路径&apos;:[props.get(&apos;unknown_path_expected_code&apos;,&apos;404&apos;)],
  &apos;网关：流式请求绕过缓存&apos;:[&apos;200&apos;], &apos;网关：重复流式请求仍绕过缓存&apos;:[&apos;200&apos;],
  &apos;缓存：功能测试首次未命中&apos;:[&apos;200&apos;], &apos;缓存：功能测试再次请求命中&apos;:[&apos;200&apos;],
  &apos;缓存：规范化 JSON 首次请求&apos;:[&apos;200&apos;], &apos;缓存：字段重排 JSON 命中&apos;:[&apos;200&apos;],
  &apos;缓存：租户隔离请求未命中&apos;:[&apos;200&apos;], &apos;缓存：供应商隔离请求未命中&apos;:[&apos;200&apos;],
  &apos;管理端：禁用供应商（POST）&apos;:[&apos;200&apos;], &apos;网关：拒绝已禁用的供应商&apos;:[&apos;400&apos;],
  &apos;管理端：启用供应商（POST）&apos;:[&apos;200&apos;], &apos;网关：重新启用的供应商路由成功&apos;:[&apos;200&apos;],
  &apos;管理端：CORS 预检请求&apos;:[&apos;200&apos;],
  &apos;管理端：查询调用日志（GET）&apos;:[&apos;200&apos;], &apos;管理端：按条件筛选调用日志&apos;:[&apos;200&apos;], &apos;管理端：查询调用成本汇总&apos;:[&apos;200&apos;],
  &apos;管理端：按供应商查询调用日志&apos;:[&apos;200&apos;], &apos;管理端：查询每日令牌用量&apos;:[&apos;200&apos;],
  &apos;管理端：删除供应商（DELETE）&apos;:[&apos;204&apos;], &apos;管理端：查询已删除的供应商&apos;:[&apos;404&apos;],
  &apos;管理端：删除不存在的供应商&apos;:[&apos;404&apos;], &apos;网关：拒绝未知供应商&apos;:[&apos;400&apos;]
]

if (expectedCodes.containsKey(label) &amp;&amp; !expectedCodes[label].contains(prev.getResponseCode())) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage(&quot;${label}: expected HTTP ${expectedCodes[label]}, actual ${prev.getResponseCode()}, body=${prev.getResponseDataAsString()}&quot;)
  return
}

def body = prev.getResponseDataAsString()
def cacheHeader = prev.getResponseHeaders()?.readLines()?.find { it.toLowerCase().startsWith(&apos;x-cache:&apos;) }

switch (label) {
  case &apos;网关：健康检查&apos;:
    if (!body.contains(&apos;UP&apos;)) throw new AssertionError(&apos;health response does not contain UP&apos;)
    break
  case &apos;网关：Prometheus 指标&apos;:
    if (!body.contains(&apos;agent_gateway&apos;)) throw new AssertionError(&apos;custom gateway metrics are missing&apos;)
    break
  case &apos;管理端：查询供应商（GET）&apos;:
    def json = new JsonSlurper().parseText(body)
    if (json.name != vars.get(&apos;TEST_PROVIDER&apos;) &amp;&amp; json.name != &apos;${TEST_PROVIDER}&apos;) throw new AssertionError(&apos;created provider name mismatch&apos;)
    break
  case &apos;管理端：查询 PUT 更新后的供应商&apos;:
    def updated = new JsonSlurper().parseText(body)
    if (updated.name != vars.get(&apos;TEST_PROVIDER&apos;)) throw new AssertionError(&apos;path name did not override request body name&apos;)
    if (updated.displayName != &apos;JMeter Test Provider Updated&apos; || updated.weight != 4) throw new AssertionError(&apos;PUT update was not persisted&apos;)
    break
  case &apos;管理端：查询权重更新后的供应商&apos;:
    def weighted = new JsonSlurper().parseText(body)
    if (weighted.weight != 7) throw new AssertionError(&apos;PATCH weight was not persisted&apos;)
    break
  case &apos;管理端：查询供应商列表（GET）&apos;:
    if (!body.contains(vars.get(&apos;TEST_PROVIDER&apos;) ?: &apos;${TEST_PROVIDER}&apos;)) throw new AssertionError(&apos;created provider is absent from list&apos;)
    break
  case &apos;网关：聊天补全&apos;:
    def json = new JsonSlurper().parseText(body)
    if (!json.choices) throw new AssertionError(&apos;chat response choices are missing&apos;)
    if (!json.usage) throw new AssertionError(&apos;chat response usage is missing&apos;)
    break
  case &apos;网关：流式请求绕过缓存&apos;:
  case &apos;网关：重复流式请求仍绕过缓存&apos;:
    if (cacheHeader) throw new AssertionError(&apos;stream response must bypass cache&apos;)
    if (props.get(&apos;strict_stream_content_type&apos;,&apos;false&apos;).toBoolean() &amp;&amp; !prev.getContentType()?.contains(&apos;text/event-stream&apos;)) {
      throw new AssertionError(&apos;stream response is not text/event-stream&apos;)
    }
    break
  case &apos;缓存：功能测试首次未命中&apos;:
    if (cacheHeader) throw new AssertionError(&apos;first unique request unexpectedly hit cache&apos;)
    vars.put(&apos;FUNCTIONAL_CACHE_BODY&apos;, body)
    break
  case &apos;缓存：功能测试再次请求命中&apos;:
    if (!cacheHeader?.toUpperCase()?.contains(&apos;HIT&apos;)) throw new AssertionError(&apos;second identical request did not hit cache&apos;)
    if (vars.get(&apos;FUNCTIONAL_CACHE_BODY&apos;) != body) throw new AssertionError(&apos;cached response differs from original upstream response&apos;)
    break
  case &apos;缓存：规范化 JSON 首次请求&apos;:
    if (cacheHeader) throw new AssertionError(&apos;first canonical JSON request unexpectedly hit cache&apos;)
    break
  case &apos;缓存：字段重排 JSON 命中&apos;:
    if (!cacheHeader?.toUpperCase()?.contains(&apos;HIT&apos;)) throw new AssertionError(&apos;reordered JSON did not reuse canonical cache key&apos;)
    break
  case &apos;缓存：租户隔离请求未命中&apos;:
  case &apos;缓存：供应商隔离请求未命中&apos;:
    if (cacheHeader) throw new AssertionError(&quot;${label} unexpectedly reused another namespace cache&quot;)
    break
  case &apos;管理端：CORS 预检请求&apos;:
    if (!prev.getResponseHeaders().toLowerCase().contains(&apos;access-control-allow-origin&apos;)) throw new AssertionError(&apos;CORS allow-origin header is missing&apos;)
    break
  case &apos;管理端：查询调用日志（GET）&apos;:
  case &apos;管理端：按条件筛选调用日志&apos;:
  case &apos;管理端：按供应商查询调用日志&apos;:
  case &apos;管理端：查询每日令牌用量&apos;:
    if (!(new JsonSlurper().parseText(body) instanceof List)) throw new AssertionError(&quot;${label} must return a JSON array&quot;)
    break
  case &apos;管理端：查询调用成本汇总&apos;:
    def json = new JsonSlurper().parseText(body)
    [&apos;totalCalls&apos;,&apos;totalTokens&apos;,&apos;totalCost&apos;,&apos;avgLatencyMs&apos;,&apos;successCount&apos;,&apos;failCount&apos;].each {
      if (!json.containsKey(it)) throw new AssertionError(&quot;cost summary missing ${it}&quot;)
    }
    break
}
            </stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="10 - L1 缓存准备" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="循环控制器">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="当 scenario=cache-l1|all 时运行" enabled="true">
          <stringProp name="IfController.condition">${__groovy([&apos;cache-l1&apos;\,&apos;all&apos;].contains(props.get(&apos;scenario&apos;\,&apos;functional&apos;)))}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="L1 请求头" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">X-Api-Key</stringProp>
                <stringProp name="Header.value">${API_KEY}</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">X-Provider</stringProp>
                <stringProp name="Header.value">${PRIMARY_PROVIDER}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="L1 缓存预热请求" enabled="true">
            <stringProp name="HTTPSampler.domain">${GW_HOST}</stringProp>
            <stringProp name="HTTPSampler.port">${GW_PORT}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.path">/v1/chat/completions</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;model&quot;:&quot;mock-model&quot;,&quot;messages&quot;:[{&quot;role&quot;:&quot;user&quot;,&quot;content&quot;:&quot;pressure-l1-${CACHE_NAMESPACE}&quot;}],&quot;temperature&quot;:0,&quot;stream&quot;:false}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="等待 L1 预热数据写入" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">Thread.sleep((props.get(&apos;cache_put_wait_ms&apos;,&apos;1000&apos;) as long)); SampleResult.setResponseCode(&apos;200&apos;); SampleResult.setSuccessful(true)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="11 - L1 Caffeine 缓存压测" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__groovy([&apos;cache-l1&apos;\,&apos;all&apos;].contains(props.get(&apos;scenario&apos;\,&apos;functional&apos;)) ? props.get(&apos;cache_threads&apos;\,&apos;200&apos;) : &apos;1&apos;)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__groovy([&apos;cache-l1&apos;\,&apos;all&apos;].contains(props.get(&apos;scenario&apos;\,&apos;functional&apos;)) ? props.get(&apos;cache_ramp&apos;\,&apos;5&apos;) : &apos;0&apos;)}</stringProp>
        <stringProp name="ThreadGroup.duration">${__P(l1_duration,50)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="循环控制器">
          <stringProp name="LoopController.loops">${__groovy([&apos;cache-l1&apos;\,&apos;all&apos;].contains(props.get(&apos;scenario&apos;\,&apos;functional&apos;)) ? -1 : 1)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="当 scenario=cache-l1|all 时运行" enabled="true">
          <stringProp name="IfController.condition">${__groovy([&apos;cache-l1&apos;\,&apos;all&apos;].contains(props.get(&apos;scenario&apos;\,&apos;functional&apos;)))}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="L1 压测请求头" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">X-Api-Key</stringProp>
                <stringProp name="Header.value">${API_KEY}</stringProp>
              </elementProp>
